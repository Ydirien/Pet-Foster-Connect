
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum Gender {
  M
  F
}

enum AnimalStatus {
  available
  in_foster_care
  completed
}

enum RequestStatus {
  pending
  accepted
  rejected
}

enum HousingType {
  house
  apartment
}

enum ExperienceLevel {
  beginner
  confirmed
  experienced
}