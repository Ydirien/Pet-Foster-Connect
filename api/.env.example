# Base Postgres locale servie par `npx prisma dev` (utilisée par le CLI Prisma ET par l'app via le driver pg)
DATABASE_URL=
SHADOW_DATABASE_URL=
ACCESS_TOKEN_SECRET=

# Port d'écoute de l'API (défaut 3000 si absent)
PORT=3000
# Origine(s) autorisées en CORS, séparées par des virgules si plusieurs
# (ex: https://petfosterconnect.fr,https://www.petfosterconnect.fr).
# Sans cette variable, l'API accepte TOUTE origine ("*") : à ne jamais laisser
# vide en production, uniquement en dev local.
ALLOWED_ORIGINS=http://localhost:5173
# Niveau de log (défaut "http" si absent)
LOG_LEVEL=http

# URL publique (côté navigateur) de l'API, utilisée par le script de seed pour
# générer les imageUrl des animaux de démo. En docker-compose, c'est
# localhost:<API_LOCAL_PORT> (port publié), pas forcément PORT (port interne
# du conteneur). Sans docker, les deux coïncident : le seed peut s'en passer.
API_PUBLIC_URL=http://localhost:3000